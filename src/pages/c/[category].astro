---
/**
 * Kategori sayfasi (FR-004).
 *
 * Statik, /c/<category>; server tarafinda getStaticPaths ile her unique
 * kategori icin bir sayfa uretilir. Client-side filtre YOK (her kategori
 * kendi URL'inde paylasilabilir).
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import BentoGrid from '../../components/BentoGrid.astro';
import { getCollection } from 'astro:content';

const CATEGORY_LABELS = {
	puzzle: 'Puzzle',
	arcade: 'Arcade',
	reflex: 'Reflex',
	word: 'Word',
	strategy: 'Strategy',
	idle: 'Idle',
} as const;

const CATEGORY_DESC = {
	puzzle: 'Slow down and think. Each tile, each tile, a tiny problem waiting.',
	arcade: 'Pick up and play. Bricks fall, balls bounce, fingers react.',
	reflex: 'Tap the right thing at the right moment. Speed sharpens the eye.',
	word: 'Letters in motion. Type, rearrange, decode.',
	strategy: 'A few moves ahead. Think, then act.',
	idle: 'Slow accumulation. Beautiful charts, gentle pressure.',
} as const;

export async function getStaticPaths() {
	const games = await getCollection('games', ({ data }) => data.status === 'published');
	const categories = new Set(games.map((g) => g.data.category));
	return Array.from(categories).map((category) => ({
		params: { category },
		props: {
			games: games.filter((g) => g.data.category === category),
			category,
		},
	}));
}

interface Props {
	games: Awaited<ReturnType<typeof getCollection<'games'>>>;
	category: keyof typeof CATEGORY_LABELS;
}

const { games, category } = Astro.props;
const label = CATEGORY_LABELS[category];
const description = CATEGORY_DESC[category];
---

<BaseLayout title={`${label} games`} description={description}>
	<section class="category-hero">
		<a href="/" class="category-back">← All games</a>
		<h1 class="category-title">{label}</h1>
		<p class="category-description">{description}</p>
		<p class="category-count">
			{games.length} {games.length === 1 ? 'game' : 'games'} in this category
		</p>
	</section>
	<BentoGrid games={games} />
</BaseLayout>

<style>
	.category-hero {
		padding: var(--space-6) 0 var(--space-8);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		max-width: 720px;
	}

	.category-back {
		display: inline-flex;
		width: max-content;
		padding: var(--space-2) var(--space-3);
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-medium);
		text-decoration: none;
		border-radius: var(--radius-md);
		transition: background-color var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
	}

	.category-back:hover,
	.category-back:focus-visible {
		background: var(--color-bg-elevated);
		color: var(--color-text);
		text-decoration: none;
	}

	.category-title {
		margin: 0;
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-bold);
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.category-description {
		margin: 0;
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
		line-height: var(--line-height-snug);
	}

	.category-count {
		margin: var(--space-2) 0 0;
		font-size: var(--font-size-sm);
		color: var(--color-text-subtle);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
</style>
