---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME } from '../lib/site';
---

<BaseLayout title="Privacy Policy" description={`${SITE_NAME} privacy policy — short and honest.`}>
	<article class="legal">
		<header>
			<a href="/" class="legal-back">← Back</a>
			<h1>Privacy Policy</h1>
			<p class="legal-meta">Last updated: 2026-07-28</p>
		</header>

		<section>
			<h2>The short version</h2>
			<p>
				<strong>No accounts. No cookies. No analytics. No third-party tracking.</strong>
				The site stores scores and preferences on your own device and that's it.
			</p>
		</section>

		<section>
			<h2>What we do not collect</h2>
			<ul>
				<li>No email address, name, or any identifier.</li>
				<li>No cookies (HTTP cookies or tracking cookies).</li>
				<li>No analytics, no fingerprinting, no third-party scripts.</li>
				<li>No server-side logs that identify you personally.</li>
				<li>No advertising, no profiling.</li>
			</ul>
		</section>

		<section>
			<h2>What lives on your device</h2>
			<p>
				When you play, your <em>best score</em>, <em>play count</em>, and <em>recently
				played</em> list are stored in your browser via <code>localStorage</code> under
				the key <code>playgrid:v1</code>. This data:
			</p>
			<ul>
				<li>Never leaves your device.</li>
				<li>Can be cleared with the "Clear" button on the home page or by clearing
					site data in your browser.</li>
				<li>Is not used for tracking across sessions.</li>
			</ul>
		</section>

		<section>
			<h2>Service worker and offline play</h2>
			<p>
				A service worker may cache game files locally so a previously opened
				game can keep working without a network. The cache sits on your device
				and can be cleared from your browser's site settings.
			</p>
		</section>

		<section>
			<h2>Children</h2>
			<p>
				The site is suitable for general audiences including children. Because
				we do not collect personal information, the usual children's-privacy
				laws (COPPA, GDPR-K) do not impose obligations on us. We have
				deliberately kept the product ad-free and account-free to keep it
				that way.
			</p>
		</section>

		<section>
			<h2>Changes to this policy</h2>
			<p>
				If we ever change the data posture (for example, by adding analytics),
				we will update this page and the in-game transparency notice before
				any change takes effect.
			</p>
		</section>

		<section>
			<h2>Contact</h2>
			<p>
				Questions about privacy can be sent to a contact address we will publish
				at launch (S1/sponsor-site-domain).
			</p>
		</section>
	</article>
</BaseLayout>

<style>
	.legal {
		max-width: 720px;
		margin: 0 auto;
		padding: var(--space-8) 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.legal-back {
		display: inline-flex;
		width: max-content;
		padding: var(--space-2) var(--space-3);
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-medium);
		text-decoration: none;
		border-radius: var(--radius-md);
	}

	.legal-back:hover,
	.legal-back:focus-visible {
		background: var(--color-bg-elevated);
		color: var(--color-text);
		text-decoration: none;
	}

	.legal h1 {
		margin: var(--space-2) 0 var(--space-2);
		font-size: var(--font-size-3xl);
	}

	.legal-meta {
		margin: 0;
		font-size: var(--font-size-sm);
		color: var(--color-text-subtle);
	}

	.legal h2 {
		margin: 0 0 var(--space-3);
		font-size: var(--font-size-lg);
		color: var(--color-text);
	}

	.legal p, .legal ul {
		margin: 0 0 var(--space-3);
		color: var(--color-text-muted);
		line-height: var(--line-height-loose);
	}

	.legal strong {
		color: var(--color-text);
	}

	.legal ul {
		padding-left: var(--space-6);
	}

	.legal li {
		margin-bottom: var(--space-1);
	}

	.legal code {
		font-family: var(--font-mono);
		font-size: 0.95em;
		padding: 2px 6px;
		background: var(--color-bg-elevated);
		border-radius: var(--radius-sm);
	}
</style>
